<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14"
    android:fillViewport="true"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Navigation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/themeAccentDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="#06B6D4"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMART BACKPACK"
                        android:textColor="#F0F0F5"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESP32 DISPLAY COMPANION"
                    android:textColor="#6B7280"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- BLE Status Pill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#12121E"
                app:cardCornerRadius="20dp"
                app:strokeColor="#1FFFFFFF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <View
                        android:id="@+id/dotStatus"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="#EF4444"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:id="@+id/tvBleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DISCONNECTED"
                        android:textColor="#EF4444"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- EXACT VERCEL PROTOTYPE BACKPACK ENCLOSURE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#181824"
            app:cardCornerRadius="28dp"
            app:strokeColor="#252538"
            app:strokeWidth="1.5dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <!-- Hardware Top LED Glow -->
                <View
                    android:id="@+id/hardwareLed"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#EF4444"
                    android:layout_marginBottom="12dp" />

                <!-- 240x240 Display Screen Frame with Inner Bezel -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="260dp"
                    android:layout_height="220dp"
                    app:cardBackgroundColor="#050508"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="#2E2E42"
                    app:strokeWidth="2dp"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center_horizontal">

                        <!-- Screen Top Bar: Spotify Logo + Mini Equalizer -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <!-- Spotify Green Tag -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">

                                <View
                                    android:layout_width="7dp"
                                    android:layout_height="7dp"
                                    android:background="#1DB954"
                                    android:layout_marginEnd="5dp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="SPOTIFY"
                                    android:textColor="#1DB954"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.08" />
                            </LinearLayout>

                            <View
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_weight="1" />

                            <!-- Mini Equalizer in Screen Top Bar -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="10dp"
                                android:orientation="horizontal"
                                android:gravity="bottom"
                                android:layout_marginEnd="6dp">

                                <View android:id="@+id/miniBar1" android:layout_width="2dp" android:layout_height="6dp" android:background="#06B6D4" android:layout_margin="1dp" />
                                <View android:id="@+id/miniBar2" android:layout_width="2dp" android:layout_height="10dp" android:background="#06B6D4" android:layout_margin="1dp" />
                                <View android:id="@+id/miniBar3" android:layout_width="2dp" android:layout_height="5dp" android:background="#06B6D4" android:layout_margin="1dp" />
                                <View android:id="@+id/miniBar4" android:layout_width="2dp" android:layout_height="8dp" android:background="#06B6D4" android:layout_margin="1dp" />
                            </LinearLayout>

                            <View
                                android:id="@+id/screenBleIndicator"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="#6B7280" />
                        </LinearLayout>

                        <!-- Screen Content: Album Art + Song Info -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Album Art Frame with Gloss Effect -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                app:cardCornerRadius="12dp"
                                app:cardBackgroundColor="#12121E"
                                app:strokeColor="#2A2A3E"
                                app:strokeWidth="1dp"
                                android:layout_marginEnd="12dp">

                                <ImageView
                                    android:id="@+id/ivScreenArtwork"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@android:drawable/ic_media_play" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvScreenTrackTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Me, Myself and I"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    android:singleLine="true" />

                                <TextView
                                    android:id="@+id/tvScreenTrackArtist"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="G-Eazy, Bebe Rexha"
                                    android:textColor="#9E9EB8"
                                    android:textSize="11sp"
                                    android:singleLine="true"
                                    android:layout_marginTop="2dp" />

                                <TextView
                                    android:id="@+id/tvScreenCustomBanner"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🎒 MY BACKPACK"
                                    android:textColor="#06B6D4"
                                    android:textSize="9sp"
                                    android:textStyle="bold"
                                    android:singleLine="true"
                                    android:layout_marginTop="6dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Progress Bar & Timers -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="4dp">

                            <ProgressBar
                                android:id="@+id/pbScreenProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="4dp"
                                android:progress="42"
                                android:progressTint="#06B6D4"
                                android:progressBackgroundTint="#202030" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="3dp">

                                <TextView
                                    android:id="@+id/tvScreenCurrentTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="1:45"
                                    android:textColor="#6B7280"
                                    android:textSize="9sp"
                                    android:fontFamily="monospace" />

                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/tvScreenRemainingTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-2:26"
                                    android:textColor="#6B7280"
                                    android:textSize="9sp"
                                    android:fontFamily="monospace" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Bottom Hardware Chin Accent (from Vercel frame) -->
                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="#2E2E44"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- REAL-TIME BLUETOOTH CONTROL HUB -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12121E"
            app:cardCornerRadius="20dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLUETOOTH HARDWARE LINK"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnConnect"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Scan &amp; Connect"
                        android:backgroundTint="#06B6D4"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="12dp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnDisconnect"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="Disconnect"
                        android:backgroundTint="#1F1F30"
                        android:textColor="#9E9EB8"
                        app:cornerRadius="12dp"
                        android:enabled="false" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- THEME SELECTOR (EXACT SAME AS VERCEL THEME PANEL) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12121E"
            app:cardCornerRadius="20dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHOOSE COLOR ACCENT"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnThemeCyber"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Cyan"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:backgroundTint="#06B6D4"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnThemePurple"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Purple"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:backgroundTint="#8B5CF6"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnThemeGreen"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Matrix"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:backgroundTint="#22C55E"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnThemeOrange"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:text="Sunset"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:backgroundTint="#F97316"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DEMO TRACK QUICK SWITCHER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12121E"
            app:cardCornerRadius="20dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRACK QUICK-LOADER"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDemoSong1"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Me, Myself"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp"
                        app:strokeColor="#3A3A52"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnDemoSong2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Starboy"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp"
                        app:strokeColor="#3A3A52"
                        app:cornerRadius="8dp"
                        android:layout_marginEnd="6dp" />

                    <Button
                        android:id="@+id/btnDemoSong3"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="Blinding"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp"
                        app:strokeColor="#3A3A52"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CUSTOM BACKPACK TEXT BANNER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#12121E"
            app:cardCornerRadius="20dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BACKPACK MARQUEE TEXT"
                    android:textColor="#6B7280"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/etCustomBanner"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:background="#1A1A2B"
                        android:hint="Type custom marquee text..."
                        android:textColorHint="#4B5563"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnUpdateBanner"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:text="Send"
                        android:backgroundTint="#06B6D4"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DIAGNOSTIC CONSOLE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:cardBackgroundColor="#05050A"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1E1E2E"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#0D0D18"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DIAGNOSTIC CONSOLE"
                        android:textColor="#6B7280"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/tvClearLogs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CLEAR"
                        android:textColor="#9CA3AF"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scrollLogs"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/tvLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="[BLE] System ready. Native scan engine active."
                        android:textColor="#10B981"
                        android:fontFamily="monospace"
                        android:textSize="10sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
