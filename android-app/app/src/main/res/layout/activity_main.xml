<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#06060C"
    android:padding="20dp"
    tools:context=".MainActivity">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎒 SMART BACKPACK"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:id="@+id/dotStatus"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="#EF4444"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvBleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DISCONNECTED"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bluetooth Control Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0F0F1A"
        app:cardCornerRadius="16dp"
        app:strokeColor="#1FFFFFFF"
        app:strokeWidth="1dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BLE Connection"
                android:textColor="#9E9EB8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scan &amp; Connect"
                    android:backgroundTint="#1DB954"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnDisconnect"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Disconnect"
                    android:backgroundTint="#2E2E42"
                    android:textColor="#FFFFFF"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Live Media Stream Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0F0F1A"
        app:cardCornerRadius="16dp"
        app:strokeColor="#1FFFFFFF"
        app:strokeWidth="1dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Media Detected"
                android:textColor="#9E9EB8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivArtwork"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="#1E1E38"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_media_play"
                    android:layout_marginEnd="16dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTrackTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No Song Playing"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/tvTrackArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Spotify or YouTube Music"
                        android:textColor="#9E9EB8"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:layout_marginTop="2dp" />

                    <TextView
                        android:id="@+id/tvPlayState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Idle"
                        android:textColor="#1DB954"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSendTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send Test Track (Starboy)"
                android:backgroundTint="#3B82F6"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Debug Logs -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BLE Debug Logs"
        android:textColor="#9E9EB8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textAllCaps="true"
        android:layout_marginBottom="6dp" />

    <ScrollView
        android:id="@+id/scrollLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A10"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System started. Ready to scan."
            android:textColor="#4ADE80"
            android:fontFamily="monospace"
            android:textSize="10sp" />
    </ScrollView>

</LinearLayout>
